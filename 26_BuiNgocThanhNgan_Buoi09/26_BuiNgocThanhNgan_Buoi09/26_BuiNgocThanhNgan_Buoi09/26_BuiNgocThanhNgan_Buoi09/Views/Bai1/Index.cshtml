@model IEnumerable<_26_BuiNgocThanhNgan_Buoi09.Models.Sach>
@using _26_BuiNgocThanhNgan_Buoi09.Models;


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
@helper Truncate(string input, int length)
{
    if (input.Length < length)
    {
        @input
    }
    else
    {
        @input.Substring(0, length)<text>...</text>
    }
}
<h2 class="text-center mb-2">Danh sách sách</h2>
<p>
    @Html.ActionLink("Create New", "Create", null,
        new { @class = "btn btn-primary" })
</p>
<div class="container">
    <div class="row g-4">
        @foreach (Sach s in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 text-center ">
                    <a href="/Bai1/XemChiTiet/?msp=@s.MaSach">
                        <img class="card-img-top mt-2"
                             src="@Url.Content("~/Content/HinhAnhSP/" + s.AnhBia)"
                             alt="@s.TenSach"
                             style="width:100%; height:300px; object-fit:contain;" />
                    </a>
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"
                            style="font-size:18px; min-height:50px;">
                            @Truncate(s.TenSach, 30)
                        </h5>

                        <div class="mt-auto">
                            @Html.ActionLink("Chi Tiết", "XemChiTiet", "Bai1",
                                new { msp = s.MaSach },
                                new { @class = "btn btn-warning m-1" })

                            @Html.ActionLink("Chọn", "XemChiTiet", "Bai1",
                                new { msp = s.MaSach },
                                new { @class = "btn btn-success m-1" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>