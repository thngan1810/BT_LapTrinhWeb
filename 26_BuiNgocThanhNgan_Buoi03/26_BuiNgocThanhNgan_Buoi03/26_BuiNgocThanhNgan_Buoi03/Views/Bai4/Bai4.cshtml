@using _26_BuiNgocThanhNgan_Buoi03.Models;
@model _26_BuiNgocThanhNgan_Buoi03.Models.ThongTin
@{
    ViewBag.Title = "Bai4";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h3>NHẬP THÔNG TIN ĐỂ ĐĂNG KÝ KHÓA HỌC</h3>
    <div class="row">
        <div class="col w-100 bg-light">Identificate Informaton </div>

    </div>
    <div class="row">
        <div class="col">
            <form action="/Bai4/HienThi" method="post">
                <div class="mb-3">
                    <label for="exampleFormControlInput1" class="form-label fw-bold">Họ và Tên: </label>
                    <input type="text" class="form-control" name="HoTen" id="HoTen" placeholder="Bui Ngoc Thanh Ngan">
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput2" class="form-label fw-bold">Mã số sinh viên: </label>
                    <input type="number" class="form-control" name="MaSV" placeholder="2001240289">
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput3" class="form-label fw-bold">Email: </label>
                    <input type="email" class="form-control" name="Email" placeholder="name@example.com">
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput4" class="form-label fw-bold">File ảnh: </label>
                    <input class="form-control form-control-sm" name="Hinh" type="file">
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Ghi chú: </label>
                    <textarea class="form-control" name="Note" rows="3" placeholder="Note Note"></textarea>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput4" class="form-label fw-bold">We are Known by: </label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true" name="Check1">
                        <label class="form-check-label">
                            Television
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true" name="Check2">
                        <label class="form-check-label">
                            Website
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true" name="Check3">
                        <label class="form-check-label">
                            NewsPaper
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlInput5" class="form-label fw-bold">Chọn ca học: </label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ChonGioHoc" id="exampleRadios1" value="Sáng 2-4-6">
                        <label class="form-check-label" for="exampleRadios1">
                            Sáng 2-4-6
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ChonGioHoc" id="exampleRadios2" value="Chiều 2-4-6">
                        <label class="form-check-label" for="exampleRadios2">
                            Chiều 2-4-6
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ChonGioHoc" id="exampleRadios3" value="Sáng 3-5-7">
                        <label class="form-check-label" for="exampleRadios3">
                            Sáng 3-5-7
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ChonGioHoc" id="exampleRadios3" value="Chiều 3-5-7">
                        <label class="form-check-label" for="exampleRadios4">
                            Chiều 3-5-7
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <label  class="form-label fw-bold">Chọn Môn Học:  </label>
                    <select name="SelectCourse" class="form-select">
                        <option value="1">1. HTML CSS Bootstrap</option>
                        <option value="2">2. C#</option>
                        <option value="3T">3. ASP.NET </option>
                    </select>
                </div>
                <div class="mb-3" >
                    <button class="btn btn-outline-primary fw-bold w-50 text-center">Đăng Ký</button>
                </div>
            </form>
        </div>
    </div>
</div>



