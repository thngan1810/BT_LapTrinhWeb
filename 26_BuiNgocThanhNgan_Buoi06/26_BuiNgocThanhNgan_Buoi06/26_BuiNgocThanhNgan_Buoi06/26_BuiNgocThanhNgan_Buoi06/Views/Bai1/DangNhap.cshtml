
@{
    ViewBag.Title = "DangNhap";
    Layout = "~/Views/Shared/_LayoutBai1.cshtml";


}

<h2>DangNhap</h2>
<div class="container">
    <form action="/Bai1/XLDangNhap" method="post">
        <div class="form-group row mb-2">
            <label for="inputEmail3" class="col-sm-2 col-form-label">Số điện thoại</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" name="txtSDT" id="inputEmail3">
            </div>
        </div>
        <div class="form-group row">
            <label for="inputPassword3" class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                <input type="password" name="textMK" class="form-control" id="inputPassword3">
            </div>
        </div>
        <div class="form-group row">
            <div class="col-sm-10">
                <button type="submit" class="btn btn-primary">ĐĂNG NHẬP</button>
            </div>
        </div>
    </form>
    @if (ViewBag.tb != null)
    {
    <p>@ViewBag.tb</p>
    }
</div>
