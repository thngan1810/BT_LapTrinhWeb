@{
    ViewBag.Title = "DangKy";
    Layout = "~/Views/Shared/_LayoutPageUser.cshtml";
}

<div class=" container-fluid">
    <h2 class="fw-bold text-center" >ĐĂNG KÝ TÀI KHOẢN</h2>
    <form>
        <div class="row mb-3">
            <label for="inputten" class="col-sm-12 col-form-label">Tên khách hàng: </label>
            <div class="col-sm-12">
                <input type="text" class="form-control" id="inputten" placeholder="Enter your name">
            </div>
        </div>
        <div class="row mb-3">
            <label for="inputemail" class="col-sm-12 col-form-label">Địa chỉ email</label>
            <div class="col-sm-12">
                <input type="email" class="form-control" id="inputemail">
            </div>
        </div>
        <div class="row mb-3">
            <label for="inputpas" class="col-sm-12 col-form-label">Password</label>
            <div class="col-sm-12">
                <input type="password" class="form-control" id="inputpas">
            </div>
        </div>
        <fieldset class="row mb-3">
            <legend class="col-form-label col-sm-2 pt-0">Giới tính</legend>
            <div class="col-sm-10 flex-column">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="gridRadios" id="gridRadios1" value="option1" checked>
                    <label class="form-check-label" for="gridRadios1">
                        Nam
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="gridRadios" id="gridRadios2" value="option2">
                    <label class="form-check-label" for="gridRadios2">
                        Nữ
                    </label>
                </div>
                <div class="form-check disabled">
                    <input class="form-check-input" type="radio" name="gridRadios" id="gridRadios3" value="option3" disabled>
                    <label class="form-check-label" for="gridRadios3">
                        Khác
                    </label>
                </div>
            </div>
        </fieldset>
        <div class="row mb-3">
            <label class="col-sm-12 col-form-label"> Nghề nghiệp</label>
            <div class="col-sm-12 ">
                <select class="form-select" id="">
                    <option selected>Choose...</option>
                    <option value="1">Giáo Viên</option>
                    <option value="2">Two</option>
                    <option value="3">Three</option>
                </select>
            </div>
        </div>
        
        <button type="submit" class="btn btn-primary">Đăng ký</button>
    </form>
</div>
