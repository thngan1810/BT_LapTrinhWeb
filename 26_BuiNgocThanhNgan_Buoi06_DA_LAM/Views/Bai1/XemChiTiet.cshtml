@using _26_BuiNgocThanhNgan_Buoi06.Models;
@model Tour
@{
    ViewBag.Title = "Chi tiết tour";
    Layout = "~/Views/Shared/_LayoutBai1.cshtml";
    var dsDichVu = ViewBag.DichVu as List<DichVuKemTour>;
    var diaDiem = (Model.DiaDiemThamQuan ?? "").Split(new[] { '.' }, System.StringSplitOptions.RemoveEmptyEntries);
}

<div class="mb-3">
    <a href="@Url.Action("Index", "Bai1")" class="btn btn-outline-secondary">&laquo; Quay lại danh sách</a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">@Model.TenTour</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-5">
                <img src="~/Content/Images/@Model.Hinh" class="img-fluid rounded border mb-3" style="max-height:330px; width:100%; object-fit:cover" alt="@Model.TenTour" />
                @if (Model.DsHinh != null && Model.DsHinh.Count > 0)
                {
                    <div class="row">
                        @foreach (string h in Model.DsHinh)
                        {
                            <div class="col-4 mb-2">
                                <img src="~/Content/Images/@h" class="img-fluid rounded border" style="height:90px; width:100%; object-fit:cover" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-md-7">
                <table class="table table-bordered">
                    <tr><th style="width:35%">Mã tour</th><td>@Model.MaTour</td></tr>
                    <tr><th>Tên tour</th><td>@Model.TenTour</td></tr>
                    <tr><th>Ngày khởi hành</th><td>@(Model.NgayKhoiHanh.HasValue ? Model.NgayKhoiHanh.Value.ToString("dd/MM/yyyy") : "")</td></tr>
                    <tr><th>Nơi khởi hành</th><td>@Model.NoiKhoiHanh</td></tr>
                    <tr><th>Thời gian lưu trú</th><td>@(string.IsNullOrWhiteSpace(Model.ThoiGianLuuTru) ? "Theo chương trình CSDL" : Model.ThoiGianLuuTru)</td></tr>
                    <tr><th>Giá tour</th><td class="text-danger fw-bold">@Model.GiaTour.ToString("N0") VNĐ</td></tr>
                </table>
            </div>
        </div>

        <hr />
        <h5 class="text-primary">CHƯƠNG TRÌNH TOUR</h5>
        <p style="white-space:pre-line">@Model.ChuongTrinhTour</p>

        <h5 class="text-primary mt-4">ĐỊA ĐIỂM THAM QUAN</h5>
        <ul>
            @foreach (string d in diaDiem)
            {
                <li>@d.Trim()</li>
            }
        </ul>

        <h5 class="text-primary mt-4">DỊCH VỤ KÈM THEO</h5>
        @if (dsDichVu != null && dsDichVu.Count > 0)
        {
            <ul>
                @foreach (DichVuKemTour dv in dsDichVu)
                {
                    <li>@dv.TenDichVu</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Chưa có dữ liệu dịch vụ.</p>
        }
    </div>
</div>
