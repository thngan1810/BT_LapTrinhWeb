@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutBai1.cshtml";
}

<div class="container">
    <h3 class="text-primary mb-3">ĐĂNG NHẬP</h3>
    <form action="@Url.Action("XLDangNhap", "Bai1")" method="post">
        <div class="form-group row mb-3">
            <label class="col-sm-3 col-form-label">Số điện thoại</label>
            <div class="col-sm-9"><input type="text" class="form-control" name="txtSDT" /></div>
        </div>
        <div class="form-group row mb-3">
            <label class="col-sm-3 col-form-label">Mật khẩu</label>
            <div class="col-sm-9"><input type="password" name="txtMK" class="form-control" /></div>
        </div>
        <button type="submit" class="btn btn-primary">ĐĂNG NHẬP</button>
    </form>
    @if (ViewBag.tb != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.tb</div>
    }
</div>
